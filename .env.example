# Used by docker-compose.yml. Copy to .env and fill in before running `docker compose up`.
JWT_SECRET=change_this_to_a_long_random_secret

# Optional — AI Mock Interview providers. Leave all blank to run in rule-based mock mode
# (question bank + heuristic scoring). Tried in this order at request time; the first one
# configured that responds successfully wins, with automatic fallback to the next.
GROQ_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional — override the code-execution judge (defaults to the free public Judge0 CE demo).
JUDGE0_BASE_URL=https://ce.judge0.com
