PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/placement_platform
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# Optional: override the Judge0 code-execution endpoint (defaults to the free public
# CE demo instance at ce.judge0.com). Point this at a self-hosted instance for production.
# JUDGE0_BASE_URL=https://ce.judge0.com

# Optional — AI Mock Interview providers. Leave all blank to run in rule-based mock mode.
# Tried in this order at request time; the first one configured that responds successfully
# wins, with automatic fallback to the next if one fails or isn't configured.
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# MISTRAL_API_KEY=
# MISTRAL_MODEL=mistral-small-latest
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
